# Copy to .env and fill in real values. See kairo-learning-engine/docs/SUPABASE_SETUP.md
# for where these come from — the anon key is safe to expose client-side, RLS enforces access.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Web Push (Batch 3) — the public half of a VAPID key pair. Generate one with
# `npx web-push generate-vapid-keys`; the private half is a Supabase Edge
# Function secret (VAPID_PRIVATE_KEY), never shipped to the client.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
